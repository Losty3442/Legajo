    especialidad : text
    * activo : integer
    * version : integer
    * creado_en : text
    * actualizado_en : text
  }
  entity "legajo" as legajo {
    * id : text <<PK>>
    --
    * docente_id : text <<FK,UQ>>
    * fecha_apertura : text
    observaciones : text
    * creado_en : text
  }
  entity "tipo_merito" as tipo_merito {
    * id : integer <<PK>>
    --
    * codigo : text <<UQ>>
    * nombre : text
    * grupo : text
    * puntua : integer
  }
  entity "documento" as documento {
    * id : text <<PK>>
    --
    * legajo_id : text <<FK>>
    * subido_por : text <<FK>>
    * nombre_original : text
    * tipo_mime : text
    * tamano_bytes : integer
    * hash_sha256 : text
    * clave_almacenamiento : text <<UQ>>
    * version : integer
    reemplaza_a : text <<FK>>
    retener_hasta : text
    * subido_en : text
  }
  entity "merito" as merito {
    * id : text <<PK>>
    --
    * legajo_id : text <<FK>>
    * tipo_merito_id : integer <<FK>>
    * titulo : text
    * institucion : text
    * fecha_merito : text
    * documento_id : text <<FK>>
    * estado_revision : text
    observacion : text
    revisado_por : text <<FK>>
    revisado_en : text
    * version : integer
    * creado_en : text
    * actualizado_en : text
  }
  entity "revision_merito" as revision_merito {
    * id : text <<PK>>
    --
    * merito_id : text <<FK>>
    * revisor_id : text <<FK>>
    * rol_id : integer <<FK>>
    * accion : text
    estado_anterior : text
    * estado_posterior : text
    documento_anterior_id : text <<FK>>
    documento_posterior_id : text <<FK>>
    nota : text
    copia_antes : text
    copia_despues : text
    * ocurrido_en : text
  }
  entity "experiencia_laboral" as experiencia_laboral {
    * id : text <<PK>>
    --
    * legajo_id : text <<FK>>
    * institucion : text
    * cargo : text
    * fecha_inicio : text
    fecha_fin : text
    * documento_id : text <<FK>>
    * actualizado_en : text
  }
}

