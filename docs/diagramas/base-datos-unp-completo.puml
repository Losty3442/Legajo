package "A · Organización y seguridad" #EAF2FF {
  entity "facultad" as facultad {
    * id : text <<PK>>
    --
    * codigo : text <<UQ>>
    * nombre : text <<UQ>>
    * activo : integer
  }
  entity "departamento_academico" as departamento_academico {
    * id : text <<PK>>
    --
    * facultad_id : text <<FK>>
    * nombre : text
    * activo : integer
  }
  entity "categoria_docente" as categoria_docente {
    * id : integer <<PK>>
    --
    * nombre : text <<UQ>>
    * orden : integer <<UQ>>
  }
  entity "dedicacion" as dedicacion {
    * id : integer <<PK>>
    --
    * nombre : text <<UQ>>
  }
  entity "rol" as rol {
    * id : integer <<PK>>
    --
    * codigo : text <<UQ>>
    * nombre : text
  }
  entity "usuario" as usuario {
    * id : text <<PK>>
    --
    * sub_externo : text <<UQ>>
    * nombre_completo : text
    * email : text <<UQ>>
    * activo : integer
    ultimo_acceso : text
    * creado_en : text
  }
  entity "asignacion_rol" as asignacion_rol {
    * id : text <<PK>>
    --
    * usuario_id : text <<FK>>
    * rol_id : integer <<FK>>
    facultad_id : text <<FK>>
    departamento_id : text <<FK>>
    * vigente_desde : text
    vigente_hasta : text
  }
}

package "B · Docente, legajo y evidencias" #E7F6EF {
  entity "docente" as docente {
    * id : text <<PK>>
    --
    usuario_id : text <<FK,UQ>>
