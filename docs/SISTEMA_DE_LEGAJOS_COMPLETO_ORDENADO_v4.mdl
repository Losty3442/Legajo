		    (object Class_Category "Casos adicionales del prototipo"
			quid       	"59EED43300BA"
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object UseCase "CUS19 Iniciar sesión"
				quid       	"59EED43300E6"
				documentation 	"Portal /login. Valida la cuenta y crea una sesión autorizada. POST /api/v1/auth/login.")
			    (object UseCase "CUS20 Cerrar sesión"
				quid       	"59EED43300E7"
				documentation 	"Acción Salir o Cerrar sesión. Invalida la sesión y vuelve a la pantalla de acceso. POST /api/v1/auth/logout.")
			    (object UseCase "CUS21 Consultar panel de gestión"
				quid       	"59EED43300E8"
				documentation 	"Panel /. Muestra indicadores, pendientes y solicitudes recientes según el perfil. GET /api/v1/workspace.")
			    (object UseCase "CUS22 Consultar legajo docente"
				quid       	"59EED43300E9"
				documentation 	"Vista /legajos/:id. Consulta resumen, grados, experiencia, méritos, documentos e historial. El docente accede a su propio legajo.")
			    (object UseCase "CUS23 Consultar y descargar evidencia"
				quid       	"59EED43300EA"
				documentation 	"Desde legajo, revisión o evaluación. Consulta y descarga la evidencia autorizada. GET /api/v1/files/:id.")
			    (object UseCase "CUS24 Consultar convocatorias y plazas"
				quid       	"59EED43300EB"
				documentation 	"Vista /convocatorias. Consulta periodos, plazas y fase del proceso. GET /api/v1/calls y /api/v1/vacancies.")
			    (object UseCase "CUS25 Consultar estado de solicitudes"
				quid       	"59EED43300EC"
				documentation 	"Vista /solicitudes. Consulta y filtra expedientes que corresponden al perfil por su estado.")
			    (object UseCase "CUS26 Consultar e imprimir resultado de evaluación"
				quid       	"59EED43300ED"
				documentation 	"Detalle /evaluaciones/:id. Consulta el resultado cerrado, su rúbrica, evidencias y conclusión. Permite imprimirlo.")
			    (object UseCase "CUS27 Guardar borrador de solicitud"
				quid       	"59EED43300EE"
				documentation 	"Nueva solicitud en /solicitudes. Selecciona docente, convocatoria y plaza y guarda un borrador. La presentación posterior corresponde al CUS09.")
			    (object UseCase "CUS28 Corregir solicitud observada"
				quid       	"59EED43300EF"
				documentation 	"Editar un expediente observado en /solicitudes. Conserva la corrección para su reenvío dentro del plazo. El reenvío corresponde al CUS09.")
			    (object UseCase "CUS29 Exportar respaldo del navegador"
				quid       	"59EED43300F0"
				documentation 	"Vista /migracion. Legajos exporta un ZIP local desde el almacenamiento anterior del navegador.")
			    (object UseCase "CUS30 Validar e importar respaldo"
				quid       	"59EED43300F1"
				documentation 	"Vista /migracion. Legajos selecciona el ZIP, revisa el informe de validación y confirma la importación verificada a PostgreSQL."))
			logical_presentations 	(list unit_reference_list))
		    (object Class_Category "Actualización v4"
			quid       	"6B0771770046"
			documentation 	"Casos 31 a 33 agregados a los casos conservados. Las relaciones reutilizan los actores y casos existentes."
			exportControl 	"Public"
			logical_models 	(list unit_reference_list
			    (object UseCase "CUS31 Registrar plaza"
				quid       	"6B0771770049"
				documentation 	"RF20. Legajos registra una plaza con código único, adscripción válida, categoría de destino y dedicación. Queda disponible y auditada. POST /api/v1/vacancies.")
			    (object UseCase "CUS32 Consultar puntaje preliminar del legajo"
				quid       	"6B077177004A"
				documentation 	"RF21. El usuario autorizado consulta en Méritos el mayor grado verificado, sus puntos según la rúbrica vigente y su sustento. Extiende la consulta del legajo cuando está activa la tabla UNP.")
			    (object UseCase "CUS33 Calificar rubros de la tabla UNP"
				quid       	"6B077177004B"
				documentation 	"RF22. La comisión ingresa puntajes y fundamento por rubro, vincula evidencias documentales verificadas o referencia del acta, y confirma el cierre. Extiende la evaluación cuando la convocatoria usa la tabla UNP.")
